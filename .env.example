# ==============================================================================
# Play with Containers - Environment Configuration Template
# Copy this file to .env before starting the infrastructure:
#   cp .env.example .env
# ==============================================================================

# Inventory Database Configuration
INVENTORY_DB_HOST=inventory-database
INVENTORY_DB_PORT=5432
INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASSWORD=inventory_secret_pass
INVENTORY_DB_NAME=inventory_db

# Billing Database Configuration
BILLING_DB_HOST=billing-database
BILLING_DB_PORT=5432
BILLING_DB_USER=billing_user
BILLING_DB_PASSWORD=billing_secret_pass
BILLING_DB_NAME=billing_db

# RabbitMQ Message Broker Configuration
RABBITMQ_HOST=rabbit-queue
RABBITMQ_PORT=5672
RABBITMQ_USER=rabbit_user
RABBITMQ_PASSWORD=rabbit_secret_pass
RABBITMQ_QUEUE=billing_queue

# Microservice Network Hosts and Ports
# The gateway resolves inventory-app over the Docker network by service name.
# There is deliberately no BILLING_APP_* setting: the gateway never talks to
# billing-app, it only publishes to RabbitMQ.
INVENTORY_APP_HOST=inventory-app
INVENTORY_APP_PORT=8080

# Gateway bind address used by the test scripts
# (scripts/test_api.py, scripts/test_audit.sh). Not read by docker-compose.yml.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=3000
