# ==============================================================================
# Play with Containers - Environment Configuration Template
# Copy this file to .env before starting the infrastructure:
#   cp .env.example .env
#
# Every variable below is READ BY THE APPLICATION CODE. The names are not
# free-form: they are the exact names in
#   srcs/api-gateway/app/{proxy,queue_sender}.py, server.py
#   srcs/inventory-app/app/__init__.py, server.py
#   srcs/billing-app/app/{__init__,consume_queue}.py, server.py
#   srcs/{inventory,billing}-database/init-db.sh
#   srcs/rabbit-queue/entrypoint.sh
# Any variable you leave UNSET here is passed to the containers as an empty
# string, so every non-secret setting below has a safe default in the code.
# ==============================================================================

# Inventory Database Configuration
INVENTORY_DB_HOST=inventory-database
INVENTORY_DB_PORT=5432
INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASSWORD=inventory_secret_pass
INVENTORY_DB_NAME=inventory_db

# Bounded database-connect budget for inventory-app (attempts x seconds). Must
# exceed a COLD database start: a fresh PostgreSQL cluster has been observed to
# need a minute or more before it accepts connections (initdb + role, database and table
# creation), so 180 x 2s = 360s avoids turning a slow database into a restart
# loop. inventory-app exits cleanly (0) if a `docker stop` arrives while it is
# still waiting, so the budget is not paid out on shutdown.
# Pause before requeueing a message the consumer could not persist. Requeueing
# instantly turns a single poison message into a hot loop against the broker, so
# the delay is what stops one bad order from becoming a denial of service. Read
# only by billing-app.
REDELIVERY_BACKOFF_SECONDS=5
DB_CONNECT_MAX_RETRIES=180
DB_CONNECT_RETRY_DELAY=2

# Billing Database Configuration
BILLING_DB_HOST=billing-database
BILLING_DB_PORT=5432
BILLING_DB_USER=billing_user
BILLING_DB_PASSWORD=billing_secret_pass
BILLING_DB_NAME=billing_db

# RabbitMQ Message Broker Configuration
RABBITMQ_HOST=rabbit-queue
RABBITMQ_PORT=5672
RABBITMQ_USER=rabbit_user
RABBITMQ_PASSWORD=rabbit_secret_pass
RABBITMQ_QUEUE=billing_queue

# Bounded publish budget in api-gateway (srcs/api-gateway/app/queue_sender.py).
# Worst case for one POST /api/billing is 2 attempts x 3s socket time plus one
# 1s backoff, so a dead broker fails fast with HTTP 503 instead of leaving the
# client hanging. Do NOT raise these without also raising the client and
# upstream timeouts - a larger budget just turns a dead broker into a hung
# request.
RABBITMQ_SOCKET_TIMEOUT=3
RABBITMQ_PUBLISH_MAX_RETRIES=2
RABBITMQ_RETRY_DELAY=1

# -----------------------------------------------------------------------------
# AMQPS / TLS - read by srcs/api-gateway/app/queue_sender.py, which applies ONE
# rule so the connection mode can never be guessed wrong:
#
#   TLS ON  : RABBITMQ_TLS is truthy ("1"/"true"/"yes"/"on"), OR
#             RABBITMQ_TLS is unset AND (RABBITMQ_PORT is 5671 OR
#             RABBITMQ_HOST starts with "amqps://")
#   TLS OFF : RABBITMQ_TLS is falsy ("0"/"false"/"no"/"off"), OR the target
#             above does not imply TLS
#
# You normally set NOTHING here. The local broker is plaintext on 5672, so the
# rule resolves to plaintext and the local stack behaves exactly as before.
#
# Both ends read this rule. api-gateway/app/queue_sender.py implements it for
# the publisher and billing-app/app/consume_queue.py implements the identical
# rule for the consumer, off the same three variables, so setting TLS here
# moves both ends together. Setting it for one service only is the failure to
# avoid: the broker would accept the gateway's publishes and leave billing-app
# reconnecting forever, and the queue would silently never drain.
# -----------------------------------------------------------------------------

# Force the mode regardless of port. Leave EMPTY/unset to let the rule decide.
# RABBITMQ_TLS=true

# CA bundle (PEM) used to verify the broker certificate, as a path VISIBLE
# INSIDE the container - mount it, do not rely on a host path. Needed for a
# broker signed by a private/self-signed CA. It REPLACES the system trust store,
# so include every CA the broker may present. Leave empty on AWS: an Amazon MQ
# certificate chains to the public Amazon Trust Services CA, which the system
# store already trusts.
# RABBITMQ_CA_FILE=/etc/ssl/certs/amqps-ca.pem

# INSECURE opt-out, off by default. Set to false to accept ANY broker
# certificate without checking the CA or the hostname. That removes the
# protection against a man-in-the-middle reading the AMQP credentials and
# queued orders. Local throwaway test brokers with a self-signed certificate
# only - never on a real deployment.
# RABBITMQ_TLS_VERIFY=false

# Microservice Network Hosts and Ports
# The gateway resolves inventory-app over the Docker network by service name.
# There is deliberately no BILLING_APP_* setting: the gateway never talks to
# billing-app, it only publishes to RabbitMQ.
INVENTORY_APP_HOST=inventory-app
INVENTORY_APP_PORT=8080

# Gateway bind address used by the test scripts
# (scripts/test_api.py, scripts/test_audit.sh). Not read by docker-compose.yml.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=3000
